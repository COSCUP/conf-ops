  "query": "INSERT INTO last_seen_positions (id, task_id, account_id, y_clock)\n             VALUES ($1, $2, $3, $4)\n             ON CONFLICT (task_id, account_id)\n             DO UPDATE SET y_clock = $4, updated_at = NOW()\n             RETURNING id, task_id, account_id, y_clock, updated_at",
