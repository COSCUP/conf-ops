  "query": "SELECT id, scope_type, scope_id, content, library_ref, source,\n                      created_by, created_at, updated_at, deleted_at\n             FROM memories\n             WHERE scope_type = $1 AND scope_id = $2\n               AND deleted_at IS NULL\n               AND ($3::UUID IS NULL OR id < $3)\n             ORDER BY id DESC\n             LIMIT $4",
