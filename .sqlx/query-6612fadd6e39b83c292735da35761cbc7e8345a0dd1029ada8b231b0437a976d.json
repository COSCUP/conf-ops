  "query": "UPDATE email_threads\n             SET subject = COALESCE($2, subject),\n                 participants = COALESCE($3, participants),\n                 updated_at = NOW()\n             WHERE id = $1\n             RETURNING id, task_id, subject, participants, message_ids,\n                       last_message_at, created_at, updated_at",
